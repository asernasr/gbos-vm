# Asahi Linux (Apple Silicon M1 / t8103 / j313) + Android 17 (16 KB Page Size) Kernel Config Fragment
# Merge on top of arch/arm64/configs/defconfig + asahi_defconfig via scripts/kconfig/merge_config.sh

# 1. Apple Silicon 16 KB Architecture & DART IOMMU
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_VA_BITS_47=y
CONFIG_ARCH_APPLE=y
CONFIG_APPLE_DART=y
CONFIG_APPLE_SART=y
CONFIG_APPLE_MBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_SMC=y
CONFIG_APPLE_SMC_RTKIT=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_PCIE_APPLE=y
CONFIG_NVME_APPLE=y

# 2. Android Core Subsystems (Binder, Ashmem, DMA-BUF Heaps, Device-Mapper, EROFS, F2FS)
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_LINEAR=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_VERITY=y
CONFIG_DM_BOW=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZ4=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_FS_VERITY=y
CONFIG_OVERLAY_FS=y
CONFIG_SECURITY_SELINUX=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_PSI=y

# 3. Apple Silicon GPU (Asahi AGX) & Display Co-Processor (Apple DCP)
CONFIG_DRM=y
CONFIG_DRM_ASAHI=y
CONFIG_DRM_APPLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_SIMPLEDRM=y

# 4. Apple Silicon Audio (MCA + TI TAS2764 Smart Amps + Cirrus CS42L83 + ALSA Loopback for DSP)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_ALOOP=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_APPLE_MCA=y
CONFIG_SND_SOC_APPLE_MACAUDIO=y
CONFIG_SND_SOC_TAS2764=y
CONFIG_SND_SOC_CS42L83=y
CONFIG_SND_SIMPLE_CARD=y

# 5. Apple Silicon Keyboard, Multi-Touch Trackpad, SMC Battery & Backlight
CONFIG_SPI_APPLE=y
CONFIG_SPMI_APPLE=y
CONFIG_I2C_APPLE=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_HID_APPLE=y
CONFIG_HID_APPLE_SPI=y
CONFIG_APPLE_MTP=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_MACSMC_POWER=y
CONFIG_MACSMC_HID=y
CONFIG_LEDS_MACSMC=y

# 6. Broadcom BCM4378 Wi-Fi & BCM4377 Bluetooth
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIBCM4377=y
CONFIG_RFKILL=y
